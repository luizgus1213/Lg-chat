NODE_ENV=development
PORT=5000

DB_NAME=lgchat
DB_USER=postgres
DB_PASS=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=lgchat_session
CSRF_COOKIE_NAME=lgchat_csrf
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE_MS=604800000

CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5000
LOG_LEVEL=info
BCRYPT_ROUNDS=10
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAIL_FROM_NAME=LG Chat
EMAIL_CODE_EXPIRES_MINUTES=15
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
UPLOAD_ROOT=public/uploads